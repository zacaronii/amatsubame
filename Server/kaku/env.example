# Copy to .env (keep it private; it's gitignored) and fill in.
TZ=UTC
# The port Kaku listens on, on the host. Put it behind HTTPS (a reverse proxy, or Tailscale) before
# using it away from home: the token is sent with every request.
KAKU_PORT=8000
# Audiobookshelf as Kaku reaches it, and an API key from Settings ▸ API Keys.
AUDIOBOOKSHELF_URL=http://audiobookshelf.local:13378
AUDIOBOOKSHELF_API_KEY=
# The token the apps send (any long random string, e.g. `openssl rand -hex 32`).
KAKU_API_TOKEN=
# The model (docs/kaku.md ▸ Model). anime-whisper needs ./convert-model.sh once; large-v3 downloads
# itself. Existing transcripts are kept when it changes; new jobs and Transcribe Again use it.
# KAKU_MODEL=anime-whisper
# KAKU_CHUNK_LENGTH=15
# Empty: each model's default (anime-whisper none, as its authors advise; large-v3 its punctuated
# prompts). "none": no prompt for any model. Any other text primes every job with it.
# KAKU_PROMPT=
# Optional: Jellyfin and an API key made for Kaku (Dashboard ▸ API Keys), for Miru's subtitles.
JELLYFIN_URL=
JELLYFIN_API_KEY=
# Optional: the web page at /ui (docs/kaku.md ▸ Web page). Only behind a proxy that signs you in
# and adds `X-Kaku-UI: <this>` to requests for /ui; empty, there's no page. Another long random string.
KAKU_UI_SECRET=
