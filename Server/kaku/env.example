# Copy to .env (keep it private; it's gitignored) and fill in.
TZ=UTC
# The port Kaku listens on, on the host. Put it behind HTTPS (a reverse proxy, or Tailscale) before
# using it away from home: the token is sent with every request.
KAKU_PORT=8000
# Audiobookshelf as Kaku reaches it, and an API key from Settings ▸ API Keys.
AUDIOBOOKSHELF_URL=http://audiobookshelf.local:13378
AUDIOBOOKSHELF_API_KEY=
# The token the apps send (any long random string, e.g. `openssl rand -hex 32`).
KAKU_API_TOKEN=
# Optional: Jellyfin and an API key made for Kaku (Dashboard ▸ API Keys), for Miru's subtitles.
JELLYFIN_URL=
JELLYFIN_API_KEY=
